#. Key:	30001.description
#. SourceLocation:	Localization/StringTables/ST_Items.csv
#: Localization/StringTables/ST_Items.csv
msgctxt "ST_Items,30001.description"
msgid "A plain linen shirt, the first thing anyone in the villages puts on."
msgstr "Простая льняная рубаха, первое, что надевает любой житель деревни."

#. Key:	30001.name
#. SourceLocation:	Localization/StringTables/ST_Items.csv
#: Localization/StringTables/ST_Items.csv
msgctxt "ST_Items,30001.name"
msgid "Villager Shirt"
msgstr "Деревенская рубаха"

#. Key:	30002.description
#. SourceLocation:	Localization/StringTables/ST_Items.csv
#: Localization/StringTables/ST_Items.csv
msgctxt "ST_Items,30002.description"
msgid "Sturdy woven trousers, patched at the knees."
msgstr "Крепкие тканые штаны с заплатами на коленях."

#. Key:	30002.name
#. SourceLocation:	Localization/StringTables/ST_Items.csv
#: Localization/StringTables/ST_Items.csv
msgctxt "ST_Items,30002.name"
msgid "Villager Pants"
msgstr "Деревенские штаны"

#. Key:	30003.description
#. SourceLocation:	Localization/StringTables/ST_Items.csv
#: Localization/StringTables/ST_Items.csv
msgctxt "ST_Items,30003.description"
msgid "Rough cloth gloves that spare the hands from blisters."
msgstr "Грубые тканевые перчатки, берегущие руки от мозолей."

#. Key:	30003.name
#. SourceLocation:	Localization/StringTables/ST_Items.csv
#: Localization/StringTables/ST_Items.csv
msgctxt "ST_Items,30003.name"
msgid "Villager Gloves"
msgstr "Деревенские перчатки"

#. Key:	30004.description
#. SourceLocation:	Localization/StringTables/ST_Items.csv
#: Localization/StringTables/ST_Items.csv
msgctxt "ST_Items,30004.description"
msgid "Simple leather sandals for village roads."
msgstr "Простые кожаные сандалии для деревенских дорог."

#. Key:	30004.name
#. SourceLocation:	Localization/StringTables/ST_Items.csv
#: Localization/StringTables/ST_Items.csv
msgctxt "ST_Items,30004.name"
msgid "Villager Sandals"
msgstr "Сандалии селянина"

#. Key:	30005.description
#. SourceLocation:	Localization/StringTables/ST_Items.csv
#: Localization/StringTables/ST_Items.csv
msgctxt "ST_Items,30005.description"
msgid "A wide cloth hat that keeps off the sun and the rain."
msgstr "Широкая тканевая шляпа, защищающая от солнца и дождя."

#. Key:	30005.name
#. SourceLocation:	Localization/StringTables/ST_Items.csv
#: Localization/StringTables/ST_Items.csv
msgctxt "ST_Items,30005.name"
msgid "Villager Hat"
msgstr "Деревенская шляпа"

#. Key:	30006.description
#. SourceLocation:	Localization/StringTables/ST_Items.csv
#: Localization/StringTables/ST_Items.csv
msgctxt "ST_Items,30006.description"
msgid "A practice blade of hard wood bound with rope, light enough for a first swing."
msgstr "Учебный клинок из твёрдого дерева, обмотанный верёвкой, достаточно лёгкий для первого удара."

#. Key:	30006.name
#. SourceLocation:	Localization/StringTables/ST_Items.csv
#: Localization/StringTables/ST_Items.csv
msgctxt "ST_Items,30006.name"
msgid "Wooden Sword"
msgstr "Деревянный меч"

