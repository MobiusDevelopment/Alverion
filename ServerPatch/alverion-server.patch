+package org.l2jmobius.gameserver.network.serverpackets;
+
+import java.util.List;
+
+import org.l2jmobius.commons.network.buffer.WriteBuffer;
+import org.l2jmobius.gameserver.entity.item.holders.ItemHolder;
+import org.l2jmobius.gameserver.network.GameClient;
+
+/**
+ * A corpse's loot for the Alverion client: the corpse's object id, how many stacks, then each stack's item id and count. No stacks says there is nothing left to take.
+ * @author Mobius
+ */
+public class ExCorpseLoot extends ServerPacket
+{
+	/** The extended packet id, one the stock client never uses. */
+	private static final int EX_ID = 0x7A01;
+
+	private final int _corpseId;
+	private final List<ItemHolder> _items;
+
+	/**
+	 * @param corpseId the corpse's object id
+	 * @param items what the corpse holds, copied here so the caller may change its list afterwards
+	 */
+	public ExCorpseLoot(int corpseId, List<ItemHolder> items)
+	{
+		_corpseId = corpseId;
+		_items = List.copyOf(items);
+	}
+
+	@Override
+	protected void writeImpl(GameClient client, WriteBuffer buffer)
+	{
+		buffer.writeByte(0xFE);
+		buffer.writeShort(EX_ID);
+		buffer.writeInt(_corpseId);
+		buffer.writeInt(_items.size());
+		for (ItemHolder item : _items)
+		{
+			buffer.writeInt(item.getId());
+			buffer.writeLong(item.getCount());
+		}
+	}
+}
