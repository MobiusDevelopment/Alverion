+package org.l2jmobius.gameserver.network.clientpackets;
+
+import java.util.Collections;
+import java.util.List;
+
+import org.l2jmobius.gameserver.entity.World;
+import org.l2jmobius.gameserver.entity.WorldObject;
+import org.l2jmobius.gameserver.entity.actor.Attackable;
+import org.l2jmobius.gameserver.entity.actor.Player;
+import org.l2jmobius.gameserver.entity.item.enums.ItemProcessType;
+import org.l2jmobius.gameserver.entity.item.holders.ItemHolder;
+import org.l2jmobius.gameserver.entity.itemcontainer.Inventory;
+import org.l2jmobius.gameserver.network.SystemMessageId;
+import org.l2jmobius.gameserver.network.serverpackets.ExCorpseLoot;
+
+/**
+ * Corpse looting for the Alverion client: looks at what a corpse holds, or takes one stack of it or all of it. Anyone standing next to the corpse may loot it.<br>
+ * Every answer is the corpse's loot list as it stands, and an empty list closes the client's loot window.
+ * @author Mobius
+ */
+public class RequestCorpseLoot extends ClientPacket
+{
+	private static final int ACTION_TAKE = 1;
+	private static final int ACTION_TAKE_ALL = 2;
+
+	/** How near a player has to stand to a corpse to loot it, in game units. */
+	private static final int LOOT_RANGE = 150;
+
+	private int _action;
+	private int _corpseId;
+	private int _index;
+	private int _itemId;
+
+	@Override
+	protected void readImpl()
+	{
+		_action = readUnsignedByte();
+		_corpseId = readInt();
+		_index = readInt();
+		_itemId = readInt();
+	}
+
+	@Override
+	protected void runImpl()
+	{
+		final Player player = getPlayer();
+		if (player == null)
+		{
+			return;
+		}
+
+		final WorldObject object = World.findObject(_corpseId);
+		if ((object == null) || !object.isAttackable() || !object.asAttackable().isDead() || !player.isInsideRadius3D(object, LOOT_RANGE))
+		{
+			player.sendPacket(new ExCorpseLoot(_corpseId, Collections.emptyList()));
+			return;
+		}
+
+		final Attackable corpse = object.asAttackable();
+		final List<ItemHolder> loot = corpse.getCorpseLoot();
+		final ExCorpseLoot answer;
+		synchronized (loot)
+		{
+			if (_action == ACTION_TAKE_ALL)
+			{
+				int index = 0;
+				while (index < loot.size())
+				{
+					if (give(player, corpse, loot.get(index)))
+					{
+						loot.remove(index);
+					}
+					else
+					{
+						index++;
+					}
+				}
+			}
+			else if ((_action == ACTION_TAKE) && (_index >= 0) && (_index < loot.size()))
+			{
+				// The item id guards against a list another looter changed since this player last saw it.
+				final ItemHolder item = loot.get(_index);
+				if ((item.getId() == _itemId) && give(player, corpse, item))
+				{
+					loot.remove(_index);
+				}
+			}
+
+			answer = new ExCorpseLoot(_corpseId, loot);
+		}
+
+		player.sendPacket(answer);
+	}
+
+	/**
+	 * Gives one stack to the player, unless their bag has no room for it.
+	 * @param player the player looting
+	 * @param corpse the corpse the stack comes from
+	 * @param item the stack
+	 * @return whether the stack went into the player's bag
+	 */
+	private static boolean give(Player player, Attackable corpse, ItemHolder item)
+	{
+		final int itemId = item.getId();
+		final long count = item.getCount();
+		if (itemId == Inventory.ADENA_ID)
+		{
+			player.addAdena(ItemProcessType.LOOT, count, corpse, true);
+			return true;
+		}
+
+		if (!player.getInventory().validateCapacityByItemId(itemId))
+		{
+			player.sendPacket(SystemMessageId.YOUR_INVENTORY_IS_FULL);
+			return false;
+		}
+
+		player.addItem(ItemProcessType.LOOT, itemId, count, corpse, true);
+		return true;
+	}
+}
