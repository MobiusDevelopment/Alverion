diff --git dist/db_installer/sql/game/character_appearance.sql dist/db_installer/sql/game/character_appearance.sql
new file mode 100644
index 0000000..16d29c4
--- /dev/null
+++ dist/db_installer/sql/game/character_appearance.sql
@@ -0,0 +1,6 @@
+-- Alverion appearance extension: each character's appearance block, as the Alverion client sent it at creation.
+CREATE TABLE IF NOT EXISTS `character_appearance` (
+  `charId` INT UNSIGNED NOT NULL DEFAULT 0,
+  `data` VARBINARY(64) NOT NULL,
+  PRIMARY KEY (`charId`)
+) DEFAULT CHARSET=latin1 COLLATE=latin1_general_ci;
