diff --git java/org/l2jmobius/gameserver/network/clientpackets/CharacterCreate.java java/org/l2jmobius/gameserver/network/clientpackets/CharacterCreate.java
--- java/org/l2jmobius/gameserver/network/clientpackets/CharacterCreate.java
+++ java/org/l2jmobius/gameserver/network/clientpackets/CharacterCreate.java
@@ -78,2 +78,3 @@
 	private byte _face;
+	private byte[] _appearance;
 	
@@ -95,2 +95,12 @@
 		_face = (byte) readInt();
+		
+		// Alverion appearance extension: the client's appearance block, after its magic number.
+		if ((remaining() >= 5) && (readInt() == org.l2jmobius.gameserver.data.sql.CharacterAppearanceTable.MAGIC))
+		{
+			final int size = readUnsignedByte();
+			if ((size > 0) && (size <= org.l2jmobius.gameserver.data.sql.CharacterAppearanceTable.MAX_SIZE) && (remaining() >= size))
+			{
+				_appearance = readBytes(size);
+			}
+		}
 	}
@@ -251,2 +251,3 @@
 		initNewChar(client, newChar);
+		org.l2jmobius.gameserver.data.sql.CharacterAppearanceTable.getInstance().store(newChar.getObjectId(), _appearance);
 		client.sendPacket(CharCreateOk.STATIC_PACKET);
